# Which LLM to use: gemini | openai | mock
#   mock = offline heuristic extractor, no API key needed (good for UI/extension testing)
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey) - has a free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional: extra CORS origins, comma-separated (chrome-extension:// origins are allowed by default)
ALLOWED_ORIGINS=

LOG_LEVEL=INFO
